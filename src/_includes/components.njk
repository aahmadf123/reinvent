{# ============================================================
   Shared component macros. Everything renders inside .rkt and
   uses only rkt- prefixed classes so output stays portable.
   ============================================================ #}

{# Slant rule — two gold bars raked to the same angle as the italic
   in the TOLEDO logotype, so section heads pick up the wordmark's
   lean without going near the artwork.

   Deliberately plain geometry. The rocket is a registered mark and
   the guide forbids redrawing or outlining it, so nothing here
   imitates its silhouette; where the rocket itself is wanted,
   brand.njk places the official file instead. #}
{% macro slant(cls="") %}
<svg class="rkt-slant{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 120 12" aria-hidden="true" focusable="false">
  <path d="M2.4 12 L4.8 0 L86 0 L83.6 12 Z" fill="currentColor"/>
  <path d="M93.4 12 L95.8 0 L109 0 L106.6 12 Z" fill="currentColor"/>
</svg>
{% endmacro %}

{# Hero. Pass media=true on the home page to run the footage reel
   behind it; every other page gets the flat Midnight Blue field.

   The reel's URL goes through the `url` filter: it lives on a data
   attribute, which Eleventy's base plugin does not rewrite, so
   without this it would miss the deploy path prefix and 404. #}
{% macro hero(eyebrow, title, lede="", sub=false, media=false) %}
<section class="rkt-hero{% if sub %} rkt-hero--sub{% endif %}">
  {% if media %}
  <div class="rkt-hero-media">
    <img src="/assets/img/rockets-hero-poster.jpg" alt="" width="1600" height="900" fetchpriority="high" decoding="async">
    {# No src: rkt.js attaches the reel only on large screens, and never
       when the visitor asks for reduced motion or is saving data. Without
       JS — including inside SIDEARM embeds — the still above stands in. #}
    <video data-rkt-reel="{{ '/assets/video/rockets-hero.mp4' | url }}" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
  </div>
  {% endif %}
  <div class="rkt-wrap">
    <p class="rkt-eyebrow rkt-lift">{{ eyebrow }}</p>
    <h1 class="rkt-display rkt-lift">{{ title | safe }}</h1>
    {% if lede %}<p class="rkt-lede rkt-lift">{{ lede }}</p>{% endif %}
    {% if caller %}<div class="rkt-lift">{{ caller() }}</div>{% endif %}
  </div>
</section>
{% endmacro %}

{# Stat strip. The visible figures animate up from zero, so the real
   values are carried in a screen-reader copy that never changes. #}
{% macro telemetry(stats) %}
<div class="rkt-telemetry">
  <ul>
    {% for s in stats %}
    <li>
      <span class="rkt-sr">{{ s.n }} {{ s.label }}</span>
      <span aria-hidden="true">
        <span class="rkt-stat" data-rkt-count>{{ s.n }}</span>
        <span class="rkt-stat-label">{{ s.label }}</span>
      </span>
    </li>
    {% endfor %}
  </ul>
</div>
{% endmacro %}

{# Section head. center=true for short, declarative sections — see the
   alignment note in site.css. #}
{% macro sechead(eyebrow, title, lede="", center=false) %}
<div class="rkt-sechead rkt-reveal{% if center %} rkt-sechead--center{% endif %}">
  {{ slant() }}
  <p class="rkt-eyebrow">{{ eyebrow }}</p>
  <h2 class="rkt-h2">{{ title | safe }}</h2>
  {% if lede %}<p class="rkt-lede">{{ lede }}</p>{% endif %}
</div>
{% endmacro %}

{% macro cards(items) %}
<ul class="rkt-cards">
  {% for c in items %}
  <li class="rkt-card rkt-reveal">
    {% if c.tag %}<span class="rkt-card-tag">{{ c.tag }}</span>{% endif %}
    <h3 class="rkt-h3"><a href="{{ c.href }}">{{ c.title }}</a></h3>
    <p>{{ c.text }}</p>
    {% if c.cta %}<span class="rkt-card-cta" aria-hidden="true">{{ c.cta }} <span class="rkt-arrow">→</span></span>{% endif %}
  </li>
  {% endfor %}
</ul>
{% endmacro %}

{% macro ctaband(title, primaryHref, primaryLabel, secondaryHref="", secondaryLabel="") %}
<section class="rkt-ctaband" aria-label="Give to the Rocket Fund">
  <div class="rkt-wrap">
    <h2 class="rkt-h2">{{ title | safe }}</h2>
    <div class="rkt-btnrow">
      <a class="rkt-btn" href="{{ primaryHref }}">{{ primaryLabel }}</a>
      {% if secondaryHref %}<a class="rkt-btn rkt-btn--ghost" href="{{ secondaryHref }}">{{ secondaryLabel }}</a>{% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{% macro figureSlot(caption) %}
<figure class="rkt-figure rkt-reveal">
  <figcaption>{{ caption }}</figcaption>
</figure>
{% endmacro %}
