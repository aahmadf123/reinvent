{% from "brand.njk" import rocketFund, athleticLogo %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Rocket Fund · Toledo Athletics</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <meta name="theme-color" content="#0a2240">

  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/assets/img/favicon-512.png" sizes="512x512" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/favicon-180.png">
  <link rel="manifest" href="/assets/site.webmanifest">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Rocket Fund · Toledo Athletics">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}Rocket Fund">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="/assets/img/share-card.png">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preload" href="/assets/fonts/saira-condensed-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/montserrat-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/reset.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="stylesheet" href="/assets/css/chrome.css">
  <script src="/assets/js/rkt.js" defer></script>
</head>
<body class="rkt-body">
<a class="rkt-skip" href="#rkt-main">Skip to main content</a>

<header class="rkt-chrome rkt-header">
  <div class="rkt-header-in">
    <a class="rkt-brand" href="/" aria-label="Rocket Fund, Toledo Athletics — home">
      {{ athleticLogo("on-navy", "", true) }}
      <span class="rkt-brand-label">Rocket&nbsp;Fund</span>
    </a>
    <button class="rkt-menu-btn" aria-expanded="false" aria-controls="rkt-nav">Menu</button>
    <nav class="rkt-nav" id="rkt-nav" aria-label="Giving site">
      <ul>
        {% for item in nav.items %}
        <li class="rkt-nav-item">
          <a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {% if item.children %}
          <ul class="rkt-sub">
            {% for child in item.children %}
            <li><a href="{{ child.href }}"{% if page.url == child.href %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
        <li class="rkt-cta"><a href="{{ nav.cta.href }}">{{ nav.cta.label }}</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="rkt-main">
<!--RKT:START page={{ page.fileSlug or "home" }}-->
<div class="rkt" data-page="{{ sidearmSlug or page.fileSlug or "home" }}">
{% if crumb %}
  <nav class="rkt-crumb" aria-label="Breadcrumb">
    <div class="rkt-wrap">
      <ol>
        <li><a href="/">Rocket Fund</a></li>
        {% for c in crumb %}
        <li><a href="{{ c.href }}">{{ c.label }}</a></li>
        {% endfor %}
        <li><span aria-current="page">{{ title }}</span></li>
      </ol>
    </div>
  </nav>
{% endif %}
{{ content | safe }}
</div>
<!--RKT:END-->
</main>

<footer class="rkt-chrome rkt-footer">
  <div class="rkt-footer-in">
    <div class="rkt-footer-brand">
      {{ rocketFund("on-navy", "md") }}
      <p>The official annual giving program of Toledo Athletics. Every gift fuels more than 400 student-athletes across 17 varsity sports.</p>
    </div>
    <div>
      <h2>Athletic Development Office</h2>
      <address>
        {% for line in site.addressLines %}{{ line }}<br>{% endfor %}
        <a href="tel:+14195302510">{{ site.phonePrimary }}</a> · <a href="tel:+14195304183">{{ site.phoneSecondary }}</a>
      </address>
    </div>
    <div>
      <h2>Quick links</h2>
      <ul>
        <li><a href="/give/">Give Now</a></li>
        <li><a href="/why-give/">Why Give</a></li>
        <li><a href="/benefits/">Benefits &amp; Giving Levels</a></li>
        <li><a href="/ways-to-give/">Ways to Give</a></li>
        <li><a href="/events/">Special Events</a></li>
        <li><a href="/team/">Meet the Team</a></li>
        <li><a href="/faq/">Frequently Asked Questions</a></li>
        <li><a href="{{ site.mainSiteUrl }}">UTRockets.com</a></li>
      </ul>
    </div>
  </div>
  <div class="rkt-footer-legal">
    <span>© 2026 The University of Toledo. Toledo Athletics marks are registered trademarks used under license.</span>
    <span class="rkt-preview-chip">{{ site.previewNote }}</span>
  </div>
</footer>
</body>
</html>
