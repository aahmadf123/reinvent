  <div class="rkt-wrap">
    {{ sechead("Where it goes", "What your gift funds", "", true) }}
    {{ cards([
      { title: "Scholarships", text: "Tuition, housing, and books — the foundation of every student-athlete's opportunity.", href: "/give/", cta: "Fund it" },
