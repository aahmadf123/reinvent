---
title: Fuel the Rockets
description: The Rocket Fund is the official annual giving program of Toledo Athletics. Your gift powers 400+ student-athletes across 17 varsity sports.
sidearmSlug: rocket-fund-home
cleanUrl: utrockets.com/give
---
{% from "components.njk" import hero, scoreboard, declaration, quoteRotator, sechead, cards, ctaband %}

{% call hero(
  "Toledo Athletics · Official Annual Giving",
  "Fuel the<br>Rockets.",
  "Your gift powers more than 400 student-athletes across 17 varsity sports — in the classroom, in competition, and in the community.",
  false,
  true,
  true
) %}
<div class="rkt-btnrow">
  <a class="rkt-btn" href="/give/">Give Now</a>
  <a class="rkt-btn rkt-btn--ghost" href="/benefits/">See your benefits</a>
</div>
{% endcall %}

<section class="rkt-section">
  <div class="rkt-wrap">
    {{ sechead(
      "Every gift is fuel",
      "What your gift powers",
      "The Rocket Fund is the athletic department's official annual giving program. It provides the essential support that lets Toledo student-athletes pursue their dreams — academically and athletically."
    ) }}
    {{ cards([
      { title: "Scholarships", text: "Keep a Toledo education within reach for every Rocket who earns the jersey.", href: "/rocket-fund/", cta: "How gifts work" },
      { title: "Academic success", text: "Tutoring, advising, and the resources that turn athletes into graduates.", href: "/rocket-fund/", cta: "How gifts work" },
      { title: "Equipment & performance", text: "The gear, nutrition, and training that keep 17 varsity programs competitive.", href: "/rocket-fund/", cta: "How gifts work" }
    ]) }}
  </div>
</section>

{{ scoreboard(
  "By the numbers",
  "The scoreboard doesn't lie",
  stats,
  [
    { src: "/assets/img/impact/impact-1.jpg", alt: "Toledo Rockets celebrate a championship", w: 1600, h: 900 },
    { src: "/assets/img/impact/impact-3.jpg", alt: "Game night on the court at Savage Arena", w: 1600, h: 900 },
    { src: "/assets/img/impact/impact-2.jpg", alt: "A Toledo student-athlete at graduation", w: 1600, h: 900 }
  ]
) }}

<section class="rkt-section">
  <div class="rkt-wrap">
    {{ sechead(
      "Ways to give",
      "Pick your launch window",
      "Annual gifts are only the beginning. Choose the way to give that fits how you cheer."
    ) }}
    {{ cards([
      { tag: "Everyday", title: "GameChange", text: "Round up everyday purchases and turn spare change into scholarships — automatically.", href: "/ways-to-give/gamechange/", cta: "Enroll" },
      { tag: "Forever", title: "Legacy Society", text: "Endow your Rocket Fund gift so it supports student-athletes in perpetuity.", href: "/ways-to-give/legacy-society/", cta: "Learn more" },
      { tag: "Alumni", title: "Varsity T Club", text: "Former Rockets: stay connected with tailgates, reunions, and appreciation nights.", href: "/ways-to-give/varsity-t-club/", cta: "Join" },
      { tag: "Boosters", title: "Downtown Coaches", text: "Weekly luncheons, the 50/50 raffle, and super-fan access — since 1937.", href: "/ways-to-give/downtown-coaches/", cta: "Join" }
    ]) }}
  </div>
</section>

{{ declaration(
  "The mission",
  "Transform lives while elevating the university and community through the power of sports."
) }}

<section class="rkt-section rkt-section--center">
  <div class="rkt-wrap">
    {{ sechead(
      "Athlete voices",
      "The people your gift reaches",
      "",
      true
    ) }}
    {{ quoteRotator(testimonials) }}
  </div>
</section>

{{ ctaband("Ready for liftoff?", "/give/", "Give Now", "/contact/", "Talk to our team") }}
