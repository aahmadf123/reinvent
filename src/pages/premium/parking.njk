          <tr>
            <td class="rkt-mono">$600+</td>
            <td>Gold</td>
            <td>Lot 10 parking pass</td>
            <td>Confirmed</td>
          </tr>
          <tr>
            <td class="rkt-mono">$1,200+</td>
            <td>Executive</td>
            <td>Premium placement</td>
            <td>Confirmed</td>
          </tr>
        </tbody>
      </table>
    </div>
