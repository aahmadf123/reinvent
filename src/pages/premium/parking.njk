{% from "components.njk" import hero, sechead, ctaband %}

{% call hero("Gameday logistics", "Premium Parking", "Every donor parks. The closer lots go to the higher levels.", true) %}
<div class="rkt-btnrow">
  <a class="rkt-btn" href="/give/">Give Now</a>
</div>
{% endcall %}

<section class="rkt-section">
  <div class="rkt-wrap">
    <div class="rkt-prose rkt-reveal">
      {{ sechead("How it works", "Three simple rules") }}
      <ol>
        <li><strong>Every donor receives a season parking pass.</strong> Give at any membership level and you're on the map.</li>
        <li><strong>Lots are assigned by membership level.</strong> Your combined annual Rocket Fund support sets your parking area.</li>
        <li><strong>Climbing levels moves you closer.</strong> From Century's Areas 3 and 4 up to the Coaches and Directors spots in Area 9.</li>
      </ol>
    </div>

    <div class="rkt-tablewrap rkt-reveal">
      <table class="rkt-table">
        <caption>Parking assignments by membership level</caption>
        <thead>
          <tr>
            <th scope="col">Level</th>
            <th scope="col">Annual giving</th>
            <th scope="col">Football parking</th>
            <th scope="col">Basketball parking</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Century</td>
            <td class="rkt-figures">$100+</td>
            <td>Areas 3 &amp; 4</td>
            <td>Area B pass</td>
          </tr>
          <tr>
            <td>Blue</td>
            <td class="rkt-figures">$300+</td>
            <td>Area 5</td>
            <td>Area B pass</td>
          </tr>
          <tr>
            <td>Gold</td>
            <td class="rkt-figures">$600+</td>
            <td>Area 10</td>
            <td>Area A pass</td>
          </tr>
          <tr>
            <td>Executive</td>
            <td class="rkt-figures">$1,200+</td>
            <td>Area 10</td>
            <td>Area A pass</td>
          </tr>
          <tr>
            <td>Coaches</td>
            <td class="rkt-figures">$2,500+</td>
            <td>Area 9</td>
            <td>Area A pass</td>
          </tr>
          <tr>
            <td>Directors</td>
            <td class="rkt-figures">$5,000+</td>
            <td>Area 9</td>
            <td>Area A pass</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="rkt-note">Basketball Area A passes cover Lots 3, 4, 5, 6 and 18. Area B passes cover Area 10 for men's games, and Areas 3, 5 and 6 for women's games (excluding doubleheaders).</p>
  </div>
</section>

<section class="rkt-section rkt-section--navy">
  <div class="rkt-wrap">
    <div class="rkt-prose rkt-reveal">
      {{ sechead("On gameday", "Know before you go") }}
      <ul>
        <li>Premium parking areas open at <strong>6:00 a.m.</strong> on football gamedays.</li>
        <li>A pass must be displayed to enter a premium area; overnight parking is not permitted.</li>
        <li>RVs, trailers, and extended vehicles for Areas 5 and 6 enter through Parking Area 4, off Douglas Rd.</li>
        <li>Area 10 is entered from the north — enter at Oakwood/Douglas and follow East Rocket Drive to Stadium Drive.</li>
      </ul>
    </div>
  </div>
</section>

